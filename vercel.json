{
  "framework": null,
  "functions": {
    "api/[...path].js": {
      "maxDuration": 30
    },
    "api/admin/login.js": {
      "maxDuration": 30
    },
    "api/admin/status.js": {
      "maxDuration": 30
    },
    "api/admin/logout.js": {
      "maxDuration": 30
    },
    "api/listings/[id].js": {
      "maxDuration": 30
    },
    "api/saved/[id].js": {
      "maxDuration": 30
    },
    "api/uploadthing.js": {
      "maxDuration": 30
    }
  },
  "rewrites": [
    
    {
      "source": "/quan-tri/dang-tin",
      "destination": "/create.html"
    },
    {
      "source": "/quan-tri",
      "destination": "/admin.html"
    },
    {
      "source": "/da-luu",
      "destination": "/saved.html"
    },
    {
      "source": "/tai-khoan",
      "destination": "/account.html"
    },
    {
      "source": "/tin/:id",
      "destination": "/detail.html"
    },
    {
      "source": "/dang-tin",
      "destination": "/quan-tri/dang-tin"
    }
  ],
  "buildCommand": "npm run build"
}
